{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "ES2020",
        "lib": ["ES2020"],
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "types": ["node", "vscode"],
        "sourceMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
